# Database
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/discovery_engine.db
# Production (PostgreSQL on Railway — set via Railway env vars):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/dbname

CHROMADB_PATH=./data/chroma

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_EMBEDDING_MODEL=all-MiniLM-L6-v2
GROQ_MAX_CONCURRENT=10
GROQ_TIMEOUT=30

# Pipeline
PIPELINE_BATCH_SIZE=50
PIPELINE_MIN_CLUSTER_SIZE=3
PIPELINE_MIN_PATTERN_OCCURRENCES=3

# Application
APP_ENV=development
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
# For production, add your Vercel domain:
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000
